          <mxGeometry x="355" y="360" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="run_return" value="return step または&#xa;(step, trajectory)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="360" y="440" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="run_start" target="run_while">
